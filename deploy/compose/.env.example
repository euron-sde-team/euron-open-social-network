# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
SOCIAL_JWT_SECRET=replace-with-output-of-make-env
SOCIAL_REFRESH_SECRET=replace-with-output-of-make-env
SOCIAL_DEMO_PASSWORD=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
SOCIAL_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env

# Optional overrides (host ports and names)
# SOCIAL_PRODUCT_NAME=Euron Open Social
# SOCIAL_LOG_LEVEL=info
# SOCIAL_WEB_PORT=3510
# SOCIAL_API_PORT=5006
# SOCIAL_PG_PORT=5452
# SOCIAL_REDIS_PORT=6389
# SOCIAL_MAILPIT_PORT=8026
# SOCIAL_SMTP_PORT=1026
# SOCIAL_FLOCI_PORT=4577
# SOCIAL_STUB_PORT=5099
