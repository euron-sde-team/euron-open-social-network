# Copy to terraform.tfvars (git-ignored) and replace every placeholder.
region      = "us-east-1"
name_prefix = "my-social-prod" # the media bucket name derives from this: make it globally unique

domain          = "app.example.com" # one host: web, /api/* and /socket.io/*
route53_zone_id = "<ROUTE53_HOSTED_ZONE_ID>" # automatic certificates + DNS; or set certificate_arn instead
# mail_domain   = "example.com"              # defaults to domain

# image_tag is passed by `make aws-deploy` (the git commit); set it here to pin a release.
# image_tag = "0.1.0"

# alarm_email = "oncall@example.com"

# Graviton tasks (cheaper). Build the images to match: PLATFORM=linux/arm64 make aws-deploy
# cpu_architecture = "ARM64"

# AI moderation (optional). Either pass the key (it lands in Terraform state) ...
# openai_api_key = "<OPENAI_API_KEY>"
# ... or create the secret empty and put the key in by hand:
# create_openai_secret = true
#   aws secretsmanager put-secret-value --secret-id <name_prefix>/openai \
#     --secret-string '{"OPENAI_API_KEY":"<key>"}'
