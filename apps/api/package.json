{
  "name": "@open-social/api",
  "version": "0.1.0",
  "private": true,
  "description": "Euron Open Social API: REST, the Socket.IO realtime gateway and the background worker.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "esbuild src/index.ts src/worker.ts src/cli.ts ../../db/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --entry-names=[name] --external:pg-native --external:sharp --sourcemap",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:types": "kysely-codegen --dialect postgres --out-file src/db/types.ts --camel-case=false",
    "demo:seed": "tsx src/cli.ts demo:seed",
    "admin:create": "tsx src/cli.ts admin:create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/client-secrets-manager": "^3.1061.0",
    "@aws-sdk/client-sesv2": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@open-social/types": "workspace:^",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.4.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "^7.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "ulid": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.11",
    "kysely-codegen": "^0.19.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
